POSTGRES_DB=belyeve
POSTGRES_USER=belyeve
POSTGRES_PASSWORD=change-me

BACKEND_PORT=8081
FRONTEND_PORT=3000
CORS_ORIGIN=https://kimberlycont.com.br
FRONTEND_API_BASE_URL=/api

SCOOP_ONE_PRICE_CENTS=17990
SCOOP_TWO_PRICE_CENTS=31990
SCOOP_THREE_PRICE_CENTS=48490

ASAAS_ENVIRONMENT=sandbox
ASAAS_SANDBOX_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_SANDBOX_API_KEY=change-me
ASAAS_PRODUCTION_BASE_URL=https://api.asaas.com/v3
ASAAS_PRODUCTION_API_KEY=
ASAAS_WEBHOOK_TOKEN=change-me-with-32-characters-minimum

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=true
PURCHASE_EMAIL_ENABLED=false
PURCHASE_EMAIL_FROM=
PURCHASE_EMAIL_TO=Belyevejoias@gmail.com
MANAGEMENT_HEALTH_MAIL_ENABLED=false
PURCHASE_CUSTOMER_EMAIL_ENABLED=false

# Melhor Envio: shipping-calculate token for the selected environment.
# Keep disabled until actual origin, technical contact and packed parcel measurements are supplied.
MELHOR_ENVIO_ENABLED=false
MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_SANDBOX_TOKEN=
MELHOR_ENVIO_PRODUCTION_TOKEN=
MELHOR_ENVIO_USER_AGENT=
MELHOR_ENVIO_ORIGIN_ZIP_CODE=
MELHOR_ENVIO_SERVICES=1,2
SHIPPING_QUOTE_TTL_SECONDS=900
SHIPPING_TIMEOUT_SECONDS=10
# cm for dimensions, kg for total weight; one fully packed order per profile.
SCOOP_1_PARCEL_WIDTH=0
SCOOP_1_PARCEL_HEIGHT=0
SCOOP_1_PARCEL_LENGTH=0
SCOOP_1_PARCEL_WEIGHT=0
SCOOP_2_PARCEL_WIDTH=0
SCOOP_2_PARCEL_HEIGHT=0
SCOOP_2_PARCEL_LENGTH=0
SCOOP_2_PARCEL_WEIGHT=0
SCOOP_3_PARCEL_WIDTH=0
SCOOP_3_PARCEL_HEIGHT=0
SCOOP_3_PARCEL_LENGTH=0
SCOOP_3_PARCEL_WEIGHT=0

# Optional OAuth app authorization (request shipping-calculate only).
MELHOR_ENVIO_OAUTH_ENABLED=false
MELHOR_ENVIO_SANDBOX_CLIENT_ID=
MELHOR_ENVIO_SANDBOX_CLIENT_SECRET=
MELHOR_ENVIO_PRODUCTION_CLIENT_ID=
MELHOR_ENVIO_PRODUCTION_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=https://www.belyeve.com.br/api/integrations/melhor-envio/callback
# Setup key: random URL-safe string, at least 43 characters. Keep server-side.
MELHOR_ENVIO_SETUP_KEY=
# 32 random bytes encoded as standard Base64; preserve across deploys/backups.
MELHOR_ENVIO_TOKEN_ENCRYPTION_KEY=
# Checkout protection: free Cloudflare Turnstile Managed widget.
# The public site key is compiled into the frontend; rebuild after changing it.
TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
TURNSTILE_TIMEOUT_SECONDS=5
# Exact proxy IPs/CIDRs only; empty ignores all forwarded headers.
CHECKOUT_TRUSTED_PROXY_CIDRS=
